<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.azad.capture</string>
  <key>BundleProgram</key>
  <string>Contents/Library/Helpers/Azad Capture.app/Contents/MacOS/azad-capture</string>
  <key>AssociatedBundleIdentifiers</key>
  <array>
    <string>ai.azad</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <!-- Keeps a driver daemon the helper started running if the helper crashes. -->
  <key>AbandonProcessGroup</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/var/log/azad-capture.log</string>
  <key>StandardErrorPath</key>
  <string>/var/log/azad-capture.log</string>
</dict>
</plist>
